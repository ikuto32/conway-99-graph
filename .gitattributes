# Research records include hashes of source files and evidence. Preserve bytes.
* -text

# Normalize only newly maintained repository infrastructure.
/.gitignore text eol=lf
/.gitmodules text eol=lf
/.gitattributes text eol=lf
/README.md text eol=lf
/requirements*.txt text eol=lf
/docs/*.md text eol=lf
/.github/workflows/*.yml text eol=lf
/tools/patches/*.patch -text
